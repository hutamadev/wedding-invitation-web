---
// Atmospheric ambient floating gradient orbs
---

<div class="pointer-events-none fixed inset-0 overflow-hidden z-0">
  <!-- Mint Orb Top-Left -->
  <div
    class="atmospheric-orb bg-gradient-mint w-[340px] h-[340px] md:w-[600px] md:h-[600px] -top-[100px] -left-[150px] md:-left-[200px] animate-float"
    style="animation-duration: 14s;"
    data-parallax="-0.15"
    aria-hidden="true"
  ></div>

  <!-- Peach Orb Mid-Right -->
  <div
    class="atmospheric-orb bg-gradient-peach w-[400px] h-[400px] md:w-[800px] md:h-[800px] top-[35%] -right-[200px] md:-right-[300px] animate-float"
    style="animation-duration: 18s; animation-delay: -4s;"
    data-parallax="0.12"
    aria-hidden="true"
  ></div>

  <!-- Lavender Orb Bottom-Left -->
  <div
    class="atmospheric-orb bg-gradient-lavender w-[320px] h-[320px] md:w-[520px] md:h-[520px] bottom-[-50px] left-[5%] md:left-[10%] animate-float"
    style="animation-duration: 16s; animation-delay: -8s;"
    data-parallax="-0.18"
    aria-hidden="true"
  ></div>

  <!-- Subtle Rose Accent Center-Bottom -->
  <div
    class="atmospheric-orb bg-gradient-rose w-[260px] h-[260px] md:w-[450px] md:h-[450px] top-[75%] right-[15%] opacity-15 animate-float"
    style="animation-duration: 20s; animation-delay: -12s;"
    data-parallax="0.14"
    aria-hidden="true"
  ></div>
</div>
