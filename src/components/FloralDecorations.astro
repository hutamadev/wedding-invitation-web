---
// Decorative floral geometric SVGs with slow floating and rotating animations
---

<div class="pointer-events-none absolute inset-0 overflow-hidden z-[5]">
  <!-- Top Left Star Flora -->
  <svg
    class="floral-deco anim-rotate-slow top-24 left-6 md:left-12 w-44 h-44 md:w-64 md:h-64 text-canvas"
    fill="none"
    viewBox="0 0 100 100"
    xmlns="http://www.w3.org/2000/svg"
    data-parallax="-0.2"
    aria-hidden="true"
  >
    <path
      d="M50 0 Q60 40 100 50 Q60 60 50 100 Q40 60 0 50 Q40 40 50 0"
      stroke="currentColor"
      stroke-width="0.5"
    ></path>
    <circle cx="50" cy="50" fill="currentColor" r="2"></circle>
  </svg>

  <!-- Mid Right Blooming Petals -->
  <svg
    class="floral-deco anim-float-slow top-[55%] right-2 md:right-8 w-60 h-60 md:w-96 md:h-96 text-canvas rotate-45"
    fill="none"
    viewBox="0 0 100 100"
    xmlns="http://www.w3.org/2000/svg"
    data-parallax="0.22"
    aria-hidden="true"
  >
    <path
      d="M50 0 C70 30 90 50 100 50 C90 50 70 70 50 100 C30 70 10 50 0 50 C10 50 30 30 50 0"
      stroke="currentColor"
      stroke-width="0.5"
    ></path>
  </svg>

  <!-- Bottom Left Geometric Blossom -->
  <svg
    class="floral-deco anim-rotate-slow bottom-48 left-8 md:left-24 w-36 h-36 md:w-52 md:h-52 text-canvas -rotate-12"
    fill="none"
    viewBox="0 0 100 100"
    xmlns="http://www.w3.org/2000/svg"
    data-parallax="-0.16"
    aria-hidden="true"
  >
    <path
      d="M50 10 Q65 40 90 50 Q65 60 50 90 Q35 60 10 50 Q35 40 50 10"
      stroke="currentColor"
      stroke-width="0.5"
    ></path>
    <path
      d="M50 25 L50 75 M25 50 L75 50"
      stroke="currentColor"
      stroke-width="0.25"
    ></path>
  </svg>
</div>
